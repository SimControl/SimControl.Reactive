<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))" />

  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <Authors>Wilhelm Medetz</Authors>
    <Company>SimControl e.U. - Wilhelm Medetz</Company>
    <Product>SimControl.Reactive</Product>
    <Copyright>Copyright (c) SimControl e.U. - Wilhelm Medetz. All rights reserved.</Copyright>
    <!--<PackageIcon>PackageIcon.png</PackageIcon>-->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/SimControl/SimControl.Reactive</RepositoryUrl>
    <!--
      <Version>0.0.0-prerelease.0.alpha</Version>   used for development integration tests
      <Version>0.0.0-prerelease.0.beta</Version>    used for integration tests with dedicated developers
      <Version>0.0.0-prerelease.0.rc</Version>      used for release tests
      <Version>0.0.0</Version>                      release version
    -->  
    <Version>0.8.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnforceCodeStyleInBuild)' != 'false'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableNETAnalyzers)' != 'false'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageVersion Include="MrAdvice" Version="2.9.5" />
    <PackageVersion Include="NCrunch.Framework" Version="4.7.0.4" />
    <PackageVersion Include="NLog" Version="4.7.13" />
    <PackageVersion Include="Nullable" Version="1.3.0" />
    <PackageVersion Include="NUnit" Version="3.13.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.2.0" />
    <PackageVersion Include="System.Threading.Channels" Version="6.0.0" />
  </ItemGroup>

</Project>
